-- BULLET TP
local bulletTP_toolConn, bulletTP_addConn
local function BulletTP_GetTarget()
    local closest, shortest = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local part = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and part then
                local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                    if dist < shortest then shortest = dist; closest = plr.Character end
                end
            end
        end
    end
    return closest
end

local function BulletTP_Snap(tool)
    if not S.BulletTPEnabled then return end
    local target = BulletTP_GetTarget()
    if not target then return end
    local targetPart = target:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end
    local char = LP.Character
    if not char then return end
    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    if not rightHand then return end
    local vel = targetPart.AssemblyLinearVelocity
    local predPos = targetPart.Position + Vector3.new(vel.X * 0.1, vel.Y * 0.1, vel.Z * 0.1)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local dir = (predPos - root.Position).Unit
    local distance = S.BulletTPDistance or 15
    local targetCF = CFrame.new(predPos - dir * distance)
    local oldGrip = tool.Grip
    tool.Parent = LP.Backpack
    rightHand.Anchored = false
    tool.Grip = (rightHand.CFrame * CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)):ToObjectSpace(targetCF):Inverse()
    rightHand.Anchored = true
    tool.Parent = char
    task.wait()
    tool.Parent = LP.Backpack
    rightHand.Anchored = false
    tool.Grip = oldGrip
    tool.Parent = char
end

local function BulletTP_Setup(character)
    if bulletTP_toolConn then bulletTP_toolConn:Disconnect(); bulletTP_toolConn = nil end
    if bulletTP_addConn then bulletTP_addConn:Disconnect(); bulletTP_addConn = nil end
    local function onTool(tool)
        if tool:IsA("Tool") and S.BulletTPEnabled then
            bulletTP_toolConn = tool.Activated:Connect(function() pcall(function() BulletTP_Snap(tool) end) end)
        end
    end
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then onTool(tool) end
    end
    bulletTP_addConn = character.ChildAdded:Connect(function(c) if c:IsA("Tool") then onTool(c) end end)
end
if LP.Character then BulletTP_Setup(LP.Character) end
