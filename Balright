-- ============================================================
-- LOCK — WITH WALLCHECK + KNOCKED CHECK
-- ============================================================
local function applyLock()
    if Target.Player then return end
    local closest, best = nil, math.huge
    local center = Camera.ViewportSize / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character.HumanoidRootPart
            if hum and hum.Health > 0 then
                -- KNOCKED CHECK
                if S.CamKnocked and hum.Health <= (S.KnockedHP or 5) then
                    -- skip
                else
                    -- WALLCHECK
                    local visible = true
                    if S.CamWallcheck then
                        visible = IsVisible(plr.Character, hrp)
                    end
                    if visible then
                        local pos, onScreen = Camera:WorldToScreenPoint(hrp.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if dist < best then best = dist; closest = plr end
                        end
                    end
                end
            end
        end
    end
    if not closest then return end
    Target.Player = closest
    Target.HRP = closest.Character.HumanoidRootPart
    CurrentTarget.Player = closest
    CurrentTarget.HRP = Target.HRP
    CamlockTarget = Target.HRP
    S.Camlock = true
end

local function releaseLock()
    Target.Player = nil
    Target.HRP = nil
    CurrentTarget.Player = nil
    CurrentTarget.HRP = nil
    CamlockTarget = nil
    S.Camlock = false
end

local function toggleLock()
    if not S.Enabled then return end
    pcall(function()
        if Target.Player then releaseLock() else applyLock() end
    end)
end

