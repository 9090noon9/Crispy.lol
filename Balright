    self.funcs.cache_character_parts = function(char, cache)
        cache.parts = cache.parts or {}
        for k in pairs(cache.parts) do cache.parts[k] = nil end
        local names = {}
        for _, c in ipairs(self.skeleton_conns) do names[c.from] = true; names[c.to] = true end
        for name in pairs(names) do
            local obj = char:FindFirstChild(name)
            if obj and obj:IsA("BasePart") then cache.parts[name] = obj
            elseif obj and obj:IsA("Accessory") then
                local h = obj:FindFirstChild("Handle")
                if h then cache.parts[name] = h end
            end
        end
    end

    self.funcs.update_skeleton = function(player, cache, char)
        if not cache.skeleton then return end
        if not ESP.visuals_enabled or not ESP.skeleton.enabled then
            for _, s in pairs(cache.skeleton) do
                if s.line then s.line.Visible = false end
                if s.outline then s.outline.Visible = false end
            end
            return
        end
        if not cache.parts then return end
        local hum = cache.humanoid
        if not hum or hum.Health <= 0 then
            for _, s in pairs(cache.skeleton) do
                if s.line then s.line.Visible = false end
                if s.outline then s.outline.Visible = false end
            end
            return
        end
        local gi = self.gui_inset
        for i, conn in ipairs(self.skeleton_conns) do
            local s = cache.skeleton[i]
            if s and s.line then
                local fp, tp = cache.parts[conn.from], cache.parts[conn.to]
                if fp and tp and fp.Parent and tp.Parent then
                    local fpos, fon = self.funcs.to_screen(fp.Position)
                    local tpos, ton = self.funcs.to_screen(tp.Position)
                    if fpos and tpos and fon and ton then
                        local dx = tpos.X - fpos.X
                        local dy = tpos.Y - fpos.Y
                        local length = math.sqrt(dx * dx + dy * dy)
                        local angle = math.deg(math.atan2(dy, dx))

                        s.line.Visible = true
                        s.line.Size = UDim2.new(0, length, 0, 1)
                        s.line.Position = UDim2.new(0, fpos.X, 0, fpos.Y - gi.Y)
                        s.line.Rotation = angle
                        s.line.BackgroundColor3 = ESP.skeleton.color

                        if s.outline and ESP.skeleton.outline.enabled then
                            s.outline.Visible = true
                            s.outline.Size = UDim2.new(0, length, 0, 3)
                            s.outline.Position = UDim2.new(0, fpos.X, 0, fpos.Y - gi.Y)
                            s.outline.Rotation = angle
                            s.outline.BackgroundColor3 = ESP.skeleton.outline.color
                        elseif s.outline then
                            s.outline.Visible = false
                        end
                    else
                        s.line.Visible = false
                        if s.outline then s.outline.Visible = false end
                    end
                else
                    s.line.Visible = false
                    if s.outline then s.outline.Visible = false end
                end
            end
        end
    end

    self.funcs.update_health = function(player, pos, size, cache, hum)
        if not ESP.visuals_enabled or not ESP.health_bar.enabled or not hum then
            local h = cache.bars and cache.bars.health
            if h then h.outline.Visible = false; h.frame.Visible = false; if h.text then h.text.Visible = false end end
            return
        end
        local target = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local last = cache.bars.health.last_health or target
        local lerped = last + (target - last) * 0.05
        cache.bars.health.last_health = lerped
        local bh = size.Y
        local bw = ESP.health_bar.width
        local x = pos.X - (bw + 3)
        local y = pos.Y - self.gui_inset.Y
        local o, f, t = cache.bars.health.outline, cache.bars.health.frame, cache.bars.health.text
        o.Visible = true
        o.Position = UDim2.new(0, x - 1, 0, y - 1)
        o.Size = UDim2.new(0, bw + 2, 0, bh + 2)
        f.Visible = true
        f.Position = UDim2.new(0, 1, 0, (1 - lerped) * bh + 1)
        f.Size = UDim2.new(0, bw, 0, lerped * bh)
        if t then
            if ESP.health_bar.text.enabled then
                local pct = math.floor(target * 100)
                t.Text = ESP.health_bar.text.show_numeric
                    and (math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth))
                    or (pct .. "%")
                t.Visible = true
                t.Position = UDim2.new(0, -15, 0, 0)
                t.Size = UDim2.new(1, 0, 0, 12)
                t.TextColor3 = ESP.health_bar.text.color
                t.TextStrokeColor3 = ESP.health_bar.text.outline_color
                t.TextSize = ESP.health_bar.text.size
            else t.Visible = false end
        end
    end

    self.funcs.update_armor = function(player, pos, size, cache, char)
        if not ESP.visuals_enabled or not ESP.armor_bar.enabled or not char then
            local a = cache.bars and cache.bars.armor
            if a then a.outline.Visible = false; a.frame.Visible = false; if a.text then a.text.Visible = false end end
            return
        end
        local be = char:FindFirstChild("BodyEffects")
        local av = be and be:FindFirstChild("Armor")
        if not av then
            local a = cache.bars and cache.bars.armor
            if a then a.outline.Visible = false; a.frame.Visible = false; if a.text then a.text.Visible = false end end
            return
        end
        local armor = av.Value or 0
        local target = math.clamp(armor / ESP.armor_bar.max_armor, 0, 1)
        local last = cache.bars.armor.last_armor or target
        local lerped = last + (target - last) * 0.05
        cache.bars.armor.last_armor = lerped
        local bh = ESP.armor_bar.width
        local bw = size.X
        local x = pos.X
        local y = pos.Y - self.gui_inset.Y + size.Y + 3
        local o, f, t = cache.bars.armor.outline, cache.bars.armor.frame, cache.bars.armor.text
        o.Visible = true
        o.Position = UDim2.new(0, x - 1, 0, y - 1)
        o.Size = UDim2.new(0, bw + 2, 0, bh + 2)
        f.Visible = true
        f.Position = UDim2.new(0, 1, 0, 1)
        f.Size = UDim2.new(0, lerped * bw, 0, bh)
        if t then
            if ESP.armor_bar.text.enabled then
                local pct = math.floor(target * 100)
                t.Text = ESP.armor_bar.text.show_numeric
                    and (math.floor(armor) .. "/" .. ESP.armor_bar.max_armor)
                    or (pct .. "%")
                t.Visible = true
                t.TextColor3 = ESP.armor_bar.text.color
                t.TextStrokeColor3 = ESP.armor_bar.text.outline_color
                t.TextSize = ESP.armor_bar.text.size
            else t.Visible = false end
        end
    end

    self.funcs.update_player = function(player)
        if not player then return end
        local cache = self.cache[player]
        if not cache then self.funcs.create_cache(player); cache = self.cache[player] end
        if not cache then return end
        local char = player.Character
        if not char or not char:IsDescendantOf(Workspace) then
            self.funcs.hide_all(cache)
            self.funcs.update_chams(player, cache, nil)
            return
        end
        local root = cache.root
        if not root or root.Parent ~= char then
            root = char:FindFirstChild("HumanoidRootPart")
            cache.root = root
            self.funcs.cache_character_parts(char, cache)
        end
        local hum = cache.humanoid
        if not hum or hum.Parent ~= char then
            hum = char:FindFirstChildWhichIsA("Humanoid")
            cache.humanoid = hum
        end
        if not root or not hum then
            self.funcs.hide_all(cache)
            return
        end
        local cam = self.vars.camera or Workspace.CurrentCamera
        self.vars.camera = cam
        if not cam then return end
        if (cam.CFrame.Position - root.Position).Magnitude > 2000 then
            self.funcs.hide_all(cache)
            return
        end
        local size, pos, br, tr = self.funcs.calc_box(root.Position)
        if size and pos and br and tr then
            self.funcs.update_box(player, pos, size, cache)
            self.funcs.update_health(player, pos, size, cache, hum)
            self.funcs.update_armor(player, pos, size, cache, char)
            self.funcs.update_labels(player, pos, size, cache, char, cam, root)
            self.funcs.update_skeleton(player, cache, char)
        else
            self.funcs.hide_all(cache)
        end
        self.funcs.update_chams(player, cache, char)
    end

    self.funcs.setup_player = function(player)
        if not player or player == LP then return end
        self.funcs.create_cache(player)
        if player.Character then self.funcs.update_player(player) end
        player.CharacterAdded:Connect(function()
            task.wait(0.1)
            self.funcs.update_player(player)
        end)
    end

    for _, p in ipairs(Players:GetPlayers()) do self.funcs.setup_player(p) end
    Players.PlayerAdded:Connect(self.funcs.setup_player)
    Players.PlayerRemoving:Connect(function(p) self.funcs.clear(p) end)

    RunService.RenderStepped:Connect(function()
        self.vars.camera = Workspace.CurrentCamera
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then self.funcs.update_player(p) end
        end
    end)
end

