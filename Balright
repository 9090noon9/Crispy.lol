local function inew(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function GetTargetPart(plr)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    if S.TargetAimBone == "Closest Part" then
        local cam = Workspace.CurrentCamera
        if not cam then return char:FindFirstChild("HumanoidRootPart") end
        local center = cam.ViewportSize / 2
        local best, bestPart = math.huge, nil
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local pos, on = cam:WorldToViewportPoint(part.Position)
                if on then
                    local m = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if m < best then best = m; bestPart = part end
                end
            end
        end
        return bestPart or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild(S.TargetAimBone) or char:FindFirstChild("HumanoidRootPart")
end

local function GetDynamicPrediction(targetPart)
    local pred = S.Prediction
    if S.PingAim then
        local ping = 0
        pcall(function()
            ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() or 0
        end)
        pred = pred + ((ping - S.PingRef) / 1000) * S.PingMult
    end
    if S.DistanceAim and targetPart then
        local myChar = LP.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHRP then
            local dist = (myHRP.Position - targetPart.Position).Magnitude
            local a = math.clamp((dist - S.DistNear) / math.max(S.DistFar - S.DistNear, 1), 0, 1)
            pred = pred * (S.DistNearMult + (S.DistFarMult - S.DistNearMult) * a)
        end
    end
    return math.clamp(pred, 0, 1)
end

