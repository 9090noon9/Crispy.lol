local function inew(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function GetCurrentPing()
    local ping = 0
    pcall(function()
        local pingstr = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString()
        local split = string.split(pingstr, "(")
        ping = tonumber(split[1]) or 0
    end)
    return ping
end

-- Returns the ping-set prediction for current ping
local function GetPingSetPrediction()
    local ping = GetCurrentPing()
    for _, set in ipairs(PingSets) do
        if ping < set.max then
            return set.pred
        end
    end
    return 0.273
end

-- Returns the distance multiplier for the given distance
local function GetDistanceMultiplier(dist)
    for _, set in ipairs(DistanceSets) do
        if dist < set.maxDist then
            return set.mult
        end
    end
    return 1.0
end

-- Get final prediction for a given target part
local function GetPredictionFor(targetPart)
    local pred = S.CamPred

    if S.PingSetsEnabled then
        pred = GetPingSetPrediction()
    elseif S.AutoPrediction then
        pred = GetPingSetPrediction()
    end

    if S.DistSetsEnabled and targetPart then
        local myChar = LP.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHRP then
            local dist = (myHRP.Position - targetPart.Position).Magnitude
            pred = pred * GetDistanceMultiplier(dist)
        end
    end

    return math.clamp(pred, 0, 3)
end

local function GetPartByName(plr, name)
    if not plr or not plr.Character then return nil end
    local char = plr.Character
    if name == "Closest Part" then
        local cam = Workspace.CurrentCamera
        if not cam then return char:FindFirstChild("HumanoidRootPart") end
        local center = cam.ViewportSize / 2
        local best, bestPart = math.huge, nil
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local pos, on = cam:WorldToViewportPoint(part.Position)
                if on then
                    local m = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if m < best then best = m; bestPart = part end
                end
            end
        end
        return bestPart or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
end

