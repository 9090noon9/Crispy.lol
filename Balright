local function GetCurrentPing()
    local ping = 0
    pcall(function()
        local p = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString()
        ping = tonumber((string.split(p, "("))[1]) or 0
    end)
    return ping
end
local function GetPingSetPrediction()
    local ping = GetCurrentPing()
    for _, set in ipairs(PingSets) do if ping < set.max then return set.pred end end
    return 0.273
end
local function GetDistanceMultiplier(dist)
    for _, set in ipairs(DistanceSets) do if dist < set.maxDist then return set.mult end end
    return 1.0
end
local function GetPredictionFor(targetPart)
    local pred = S.CamPred
    if S.PingSetsEnabled or S.AutoPrediction then pred = GetPingSetPrediction() end
    if S.DistSetsEnabled and targetPart then
        local myChar = LP.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHRP then pred = pred * GetDistanceMultiplier((myHRP.Position - targetPart.Position).Magnitude) end
    end
    return math.clamp(pred, 0, 3)
end

local function GetClosestPartToCrosshair(char)
    if not char then return nil end
    local cam = Workspace.CurrentCamera
    if not cam then return char:FindFirstChild("HumanoidRootPart") end
    local center = cam.ViewportSize / 2
    local best, bestPart = math.huge, nil
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            local pos, on = cam:WorldToViewportPoint(part.Position)
            if on and pos.Z > 0 then
                local m = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if m < best then best = m; bestPart = part end
            end
        end
    end
    return bestPart or char:FindFirstChild("HumanoidRootPart")
end

-- wallcheck helper
local function IsVisible(targetChar, targetPart)
    if not targetChar or not targetPart then return false end
    local origin = Camera.CFrame.Position
    local dest = targetPart.Position
    local dir = dest - origin
    local dist = dir.Magnitude
    if dist < 0.1 then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character, Camera, targetChar }
    params.IgnoreWater = true
    local result = Workspace:Raycast(origin, dir, params)
    return result == nil
end

-- knocked check
local function IsKnocked(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.Health <= (S.KnockedHP or 5) then return true end
    return false
end

