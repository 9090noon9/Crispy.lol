local DEFAULT_CAMERA_TYPE = Camera.CameraType

local function applyLock()
    if Target.Player then return end
    local closest, best = nil, math.huge
    local center = Camera.ViewportSize / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local sp, on = Camera:WorldToViewportPoint(hrp.Position)
                if on then
                    local m = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if m < best then best = m; closest = plr end
                end
            end
        end
    end
    if not closest or not closest.Character then return end
    local hrp = closest.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    Target.Player = closest
    Target.HRP = hrp
    CurrentTarget.Player = closest
    CurrentTarget.HRP = hrp
    CamlockTarget = hrp
    S.Camlock = true
    Camera.CameraType = Enum.CameraType.Scriptable
end

local function releaseLock()
    Target.Player = nil
    Target.HRP = nil
    CurrentTarget.Player = nil
    CurrentTarget.HRP = nil
    CamlockTarget = nil
    S.Camlock = false
    Camera.CameraType = DEFAULT_CAMERA_TYPE
end

local function toggleLock()
    if not S.Enabled then return end
    pcall(function()
        if Target.Player then releaseLock() else applyLock() end
    end)
end

local function GetAutoAirPart(targetChar)
    if not targetChar then return S.AutoAirPart end
    local hum = targetChar:FindFirstChildOfClass("Humanoid")
    if not hum then return S.AutoAirPart end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
        return "RightFoot"
    end
    return S.AutoAirPart
end

-- ============================================================
-- HOOK CACHE UPDATE LOOP — this is what stops the crash.
-- Runs every frame, computes prediction ONCE, hook just reads it.
-- ============================================================
RunService.RenderStepped:Connect(function()
    local tp = Target.Player
    if not S.Enabled or not tp or not tp.Character then
        HookCache.active = false
        return
    end
    local char = tp.Character
    if not char.Parent then
        HookCache.active = false
        return
    end
    local hrp = Target.HRP
    if not hrp or not hrp.Parent then
        HookCache.active = false
        return
    end
    local part = char:FindFirstChild(S.SilentAimPart) or hrp
    if not part or not part.Parent then
        HookCache.active = false
        return
    end
    local pred = GetPredictionFor(part)
    HookCache.predPos = part.Position + part.Velocity * pred + Vector3.new(0, S.JumpOffset, 0)
    HookCache.targetHRP = hrp
    HookCache.active = true
end)

-- ============================================================
-- CAMLOCK BIND (crash-proof — full pcall, no function calls that recurse)
-- ============================================================
RunService:BindToRenderStep("CrispyCamlock", Enum.RenderPriority.Camera.Value + 1, function(dt)
    pcall(function()
        local target = CamlockTarget
        local tp = Target.Player
        if not S.Camlock or not target or not target.Parent or not tp or not tp.Character then
            if Camera.CameraType == Enum.CameraType.Scriptable and not S.Camlock then
                Camera.CameraType = DEFAULT_CAMERA_TYPE
            end
            return
        end
        local char = tp.Character
        if not char.Parent then return end
        local aimPartName = S.AimPart
        if S.AutoAir then aimPartName = GetAutoAirPart(char) end
        local part = char:FindFirstChild(aimPartName) or target
        if not part or not part.Parent then return end

        local pred = GetPredictionFor(part)
        local predictedPos = part.Position + part.Velocity * pred

        if S.AntiGround then
            local myChar = LP.Character
            local grounded = false
            if myChar and myChar:FindFirstChildOfClass("Humanoid") then
                grounded = myChar.Humanoid.FloorMaterial ~= Enum.Material.Air
            end
            if grounded then
                predictedPos = part.Position + Vector3.new(part.Velocity.X * pred, math.max(part.Velocity.Y * pred, 0), part.Velocity.Z * pred)
            end
        end

        if Camera.CameraType ~= Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Scriptable
        end
        local targetCFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
        if S.LockMethod == "Mouse" then
            local alpha = math.clamp(1 - S.CamSmooth, 0.01, 1)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
        else
            Camera.CFrame = targetCFrame
        end
    end)
end)

