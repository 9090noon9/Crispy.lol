-- Hooks (no function calls inside — cached only)
local oldnc
oldnc = hookmetamethod(game, "__namecall", newcclosure(function(self_, ...)
    if checkcaller() or not HookCache.active then return oldnc(self_, ...) end
    local method = getnamecallmethod()
    if method ~= "Raycast" and not string.find(method, "FindPartOnRay", 1, true) then
        return oldnc(self_, ...)
    end
    local args = { ... }
    if method == "Raycast" and self_ == Workspace and #args >= 3 then
        local dir = HookCache.predPos - args[1]
        if dir.Magnitude > 0.001 then
            args[2] = dir.Unit * 1000
            return oldnc(self_, table.unpack(args))
        end
    elseif typeof(args[1]) == "Ray" then
        local dir = HookCache.predPos - args[1].Origin
        if dir.Magnitude > 0.001 then
            args[1] = Ray.new(args[1].Origin, dir.Unit * 1000)
            return oldnc(self_, table.unpack(args))
        end
    end
    return oldnc(self_, ...)
end))

local oldidx
oldidx = hookmetamethod(game, "__index", newcclosure(function(self_, key)
    if checkcaller() then return oldidx(self_, key) end
    if not S.Silent or not HookCache.active then return oldidx(self_, key) end
    if self_ ~= Mouse then return oldidx(self_, key) end
    if key == "Hit" then
        return CFrame.new(HookCache.predPos)
    elseif key == "Target" then
        return HookCache.targetHRP
    end
    return oldidx(self_, key)
end))

