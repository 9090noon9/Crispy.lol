local function SafeFireClickDetector(padName)
    if not padName then return false end
    local function findPad()
        local map = Workspace:FindFirstChild("MAP")
        if map then
            local pads = map:FindFirstChild("Pads")
            if pads then
                local pad = pads:FindFirstChild(padName)
                if pad and pad:FindFirstChildOfClass("ClickDetector") then return pad end
            end
            local shops = map:FindFirstChild("Shops")
            if shops then
                local pad = shops:FindFirstChild(padName)
                if pad and pad:FindFirstChildOfClass("ClickDetector") then return pad end
            end
        end
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == padName then
                local det = obj:FindFirstChildOfClass("ClickDetector")
                if det then return obj end
            end
        end
        return nil
    end
    local pad = findPad()
    if not pad then return false end
    local det = pad:FindFirstChildOfClass("ClickDetector") or pad:FindFirstChildWhichIsA("ClickDetector")
    if det then pcall(function() fireclickdetector(det) end); return true end
    return false
end

task.spawn(function()
    while task.wait(0.5) do
        if S.AutoFood and S.SelectedFood then pcall(SafeFireClickDetector, S.SelectedFood) end
        if S.AutoArmor and S.SelectedArmor then pcall(SafeFireClickDetector, S.SelectedArmor) end
    end
end)

