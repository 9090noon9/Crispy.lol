        local center = Camera.ViewportSize / 2
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local sp, on = Camera:WorldToViewportPoint(hrp.Position)
                    if on then
                        local m = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if m < best then best = m; closest = plr end
                    end
                end
            end
        end
        if closest and closest.Character then
            local hrp = closest.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                Target.Player = closest
                Target.HRP = hrp
                CurrentTarget.Player = closest
                CurrentTarget.HRP = hrp
            end
        end
    end

    local activeHRP = Target.HRP or CamlockTarget
    if activeHRP and activeHRP.Parent and S.Strafe and LP.Character then
        StrafeAngle = StrafeAngle + dt * S.StrafeSpeed
        local off = Vector3.new(math.cos(StrafeAngle) * S.StrafeDist, S.StrafeHeight, math.sin(StrafeAngle) * S.StrafeDist)
        local pos = activeHRP.Position + off
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if S.ViewTarget then Camera.CFrame = CFrame.new(pos, activeHRP.Position)
            else hrp.CFrame = CFrame.new(pos, activeHRP.Position) end
        end
    elseif activeHRP and activeHRP.Parent and S.ViewTarget then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, activeHRP.Position)
    end
end)

-- HIT DETECT
local lastHealthCache = {}
RunService.PostSimulation:Connect(function()
    local tp = CurrentTarget.Player
    if not S.Enabled or not tp or not tp.Character then return end
    local hum = tp.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local uid = tp.UserId
    local last = lastHealthCache[uid] or hum.Health
    if hum.Health < last then
        pcall(PlayHitSound)
        if S.HitEffectEnabled then
            local hrp = tp.Character:FindFirstChild("HumanoidRootPart")
            if hrp then pcall(HitEffect, hrp.Position) end
        end
    end
    lastHealthCache[uid] = hum.Health
end)
Players.PlayerRemoving:Connect(function(p) lastHealthCache[p.UserId] = nil end)

