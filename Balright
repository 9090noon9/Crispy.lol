local DEFAULT_CAMERA_TYPE = Camera.CameraType

local function applyLock()
    if Target.Player then return end

    local closest, best = nil, math.huge
    local center = Camera.ViewportSize / 2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local sp, on = Camera:WorldToViewportPoint(hrp.Position)
                if on then
                    local m = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if m < best then best = m; closest = plr end
                end
            end
        end
    end

    if not closest or not closest.Character then return end
    local hrp = closest.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    Target.Player = closest
    Target.HRP = hrp
    CurrentTarget.Player = closest
    CurrentTarget.HRP = hrp
    CamlockTarget = hrp
    S.Camlock = true
    Camera.CameraType = Enum.CameraType.Scriptable
end

local function releaseLock()
    Target.Player = nil
    Target.HRP = nil
    CurrentTarget.Player = nil
    CurrentTarget.HRP = nil
    CamlockTarget = nil
    S.Camlock = false
    Camera.CameraType = DEFAULT_CAMERA_TYPE
end

local function toggleLock()
    if not S.Enabled then return end
    pcall(function()
        if Target.Player then releaseLock() else applyLock() end
    end)
end

RunService:BindToRenderStep("CrispyCamlock", Enum.RenderPriority.Camera.Value + 1, function(dt)
    pcall(function()
        local target = CamlockTarget
        if S.Camlock and target and target.Parent then
            if Camera.CameraType ~= Enum.CameraType.Scriptable then
                Camera.CameraType = Enum.CameraType.Scriptable
            end
            local pred = target.Position
                + target.Velocity * S.CamPred
                + Vector3.new(0, S.CamJump, 0)
            local alpha = 1 - math.exp(-dt / math.max(S.CamSmooth, 0.001))
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pred), alpha)
        elseif not S.Camlock and Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = DEFAULT_CAMERA_TYPE
        end
    end)
end)

local oldnc
oldnc = hookmetamethod(game, "__namecall", newcclosure(function(self_, ...)
    if checkcaller() then return oldnc(self_, ...) end

    local method = getnamecallmethod()
    local args = { ... }
    local activeHRP = Target.HRP or CamlockTarget

    if S.Enabled and activeHRP and activeHRP.Parent and Target.Player and Target.Player.Character then
        local hitPart = GetTargetPart(Target.Player)

        if method == "Raycast" and self_ == Workspace and #args >= 3 and hitPart then
            local pred = hitPart.Position
                + hitPart.Velocity * GetDynamicPrediction(hitPart)
                + Vector3.new(0, S.JumpOffset, 0)
            local dir = pred - args[1]
            args[2] = dir.Unit * 1000
            return oldnc(self_, table.unpack(args))
        end

        if string.find(method, "FindPartOnRay", 1, true) and typeof(args[1]) == "Ray" and hitPart then
            local pred = hitPart.Position
                + hitPart.Velocity * GetDynamicPrediction(hitPart)
                + Vector3.new(0, S.JumpOffset, 0)
            local dir = pred - args[1].Origin
            args[1] = Ray.new(args[1].Origin, dir.Unit * 1000)
            return oldnc(self_, table.unpack(args))
        end
    end

    return oldnc(self_, ...)
end))

local oldidx
oldidx = hookmetamethod(game, "__index", newcclosure(function(self_, key)
    if checkcaller() then return oldidx(self_, key) end

    local activeHRP = Target.HRP or CamlockTarget

    if S.Enabled and S.Silent and self_ == Mouse and activeHRP and activeHRP.Parent and Target.Player and Target.Player.Character then
        if key == "Hit" then
            local part = GetTargetPart(Target.Player) or activeHRP
            return CFrame.new(
                part.Position
                + part.Velocity * GetDynamicPrediction(part)
                + Vector3.new(0, S.JumpOffset, 0)
            )
        elseif key == "Target" then
            return activeHRP
        end
    end

    return oldidx(self_, key)
end))

