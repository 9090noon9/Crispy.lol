        local square, outline, frame, gradient = full.square, full.outline, full.frame, full.gradient
        if not ESP.visuals_enabled or not ESP.box.enabled then
            square.Visible=false; outline.Visible=false; if frame then frame.Visible=false end
            return
        end
        outline.Visible = true
        outline.Position = pos - Vector2.new(1,1)
        outline.Size = size + Vector2.new(2,2)
        outline.Color = ESP.box.outline_color
        outline.Thickness = 1
        outline.Filled = false
        outline.ZIndex = 2
        if ESP.box.filled and frame and gradient then
            frame.Visible = true
            frame.Position = UDim2.new(0, pos.X, 0, pos.Y - self.gui_inset.Y)
            frame.Size = UDim2.new(0, size.X, 0, size.Y)
            frame.BackgroundTransparency = ESP.box.transparency
            if ESP.box.gradient.enabled then
                local rs = ESP.box.gradient.rotation_speed or 0
                local base = ESP.box.gradient.rotation or 90
                if not cache.gradient_rotation then cache.gradient_rotation = base end
                if rs ~= 0 then
                    cache.gradient_rotation = cache.gradient_rotation + rs
                    if cache.gradient_rotation >= 360 then cache.gradient_rotation = cache.gradient_rotation - 360
                    elseif cache.gradient_rotation < 0 then cache.gradient_rotation = cache.gradient_rotation + 360 end
                else cache.gradient_rotation = base end
                gradient.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, ESP.box.gradient.top_color),
                    ColorSequenceKeypoint.new(1, ESP.box.gradient.bottom_color),
                })
                gradient.Rotation = cache.gradient_rotation
                if not gradient.Parent then gradient.Parent = frame end
            else
                if gradient.Parent then gradient.Parent = nil end
                frame.BackgroundColor3 = ESP.box.color
            end
            square.Visible = false
        else
            square.Visible = true
            square.Position = pos
            square.Size = size
            square.Color = ESP.box.color
            square.Thickness = ESP.box.filled and 0 or ESP.box.thickness
            square.Filled = ESP.box.filled
            square.Transparency = ESP.box.transparency
            square.ZIndex = 3
            if frame then frame.Visible = false end
