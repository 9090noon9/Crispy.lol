-- ============================================================
-- MAIN LOOPS
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    if S.Enabled and S.AutoSelect then
        local p
        local best = math.huge
        local center = Camera.ViewportSize / 2
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local sp, on = Camera:WorldToViewportPoint(hrp.Position)
                    if on then
                        local m = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if m < best then best = m; p = plr end
                    end
                end
            end
        end
        if p then
            Target.Player = p
            Target.HRP = p.Character.HumanoidRootPart
            CurrentTarget.Player = p
            CurrentTarget.HRP = Target.HRP
        end
    end

    local activeHRP = Target.HRP or CamlockTarget

    if activeHRP and S.Strafe and LP.Character then
        StrafeAngle = StrafeAngle + dt * S.StrafeSpeed
        local off = Vector3.new(math.cos(StrafeAngle) * S.StrafeDist, S.StrafeHeight, math.sin(StrafeAngle) * S.StrafeDist)
        local pos = activeHRP.Position + off
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if S.ViewTarget then
                Camera.CFrame = CFrame.new(pos, activeHRP.Position)
            else
                hrp.CFrame = CFrame.new(pos, activeHRP.Position)
            end
        end
    elseif activeHRP and S.ViewTarget then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, activeHRP.Position)
    end

    if S.AutoAir and activeHRP and LP.Character and not AirDebounce then
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if tool and activeHRP.Velocity.Y > 15 then
            AirDebounce = true
            task.spawn(function()
                tool:Activate()
                task.wait(S.AutoAirDelay)
                AirDebounce = false
            end)
        end
    end
end)

-- ============================================================
-- HIT DETECT
-- ============================================================
local lastHealthCache = {}
RunService.PostSimulation:Connect(function()
    local targetPlayer = CurrentTarget.Player
    if not S.Enabled or not targetPlayer or not targetPlayer.Character then return end
    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local uid = targetPlayer.UserId
    local last = lastHealthCache[uid] or humanoid.Health
    if humanoid.Health < last then
        PlayHitSound()
        if S.HitEffectEnabled then
            local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then PlayHitEffect(hrp.Position, Color3.fromRGB(91,177,252)) end
        end
    end
    lastHealthCache[uid] = humanoid.Health
end)

Players.PlayerRemoving:Connect(function(p) lastHealthCache[p.UserId] = nil end)

