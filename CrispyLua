-- CAMLOCK SMOOTHING (scriptable camera, no zoom pulse)
-- ============================================================
RunService:BindToRenderStep("CrispyCamlock", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if S.Camlock and CamlockTarget then
        if Camera.CameraType ~= Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Scriptable
        end
        local pred = CamlockTarget.Position
            + CamlockTarget.Velocity * S.CamPred
            + Vector3.new(0, S.CamJump, 0)
        local alpha = 1 - math.exp(-dt / math.max(S.CamSmooth, 0.001))
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pred), alpha)
    elseif Camera.CameraType == Enum.CameraType.Scriptable and not S.Camlock then
        Camera.CameraType = DEFAULT_CAMERA_TYPE
    end
end)

-- ============================================================
-- __namecall HOOK (silent aim raycast redirect)
-- ============================================================
local oldnc
oldnc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    if checkcaller() then return oldnc(self, ...) end
    local method = getnamecallmethod()
    local args = { ... }
    local activeHRP = Target.HRP or CamlockTarget
    if S.Enabled and activeHRP and Target.Player then
        local hitPart = GetTargetPart(Target.Player)
        if method == "Raycast" and self == Workspace and #args >= 3 and hitPart then
            local origin = args[1]
            local pred = hitPart.Position + hitPart.Velocity * S.Prediction + Vector3.new(0, S.JumpOffset, 0)
            local dir = pred - origin
            if CurrentTool == "Double Barrel" or CurrentTool == "Tactical Shotgun" then
                dir = dir + Vector3.new(math.random(-80,80)/100, math.random(-80,80)/100, math.random(-80,80)/100)
            end
            args[2] = dir.Unit * 1000
            return oldnc(self, table.unpack(args))
        end
        if string.find(method, "FindPartOnRay", 1, true) and typeof(args[1]) == "Ray" and hitPart then
            local ray = args[1]
            local pred = hitPart.Position + hitPart.Velocity * S.Prediction + Vector3.new(0, S.JumpOffset, 0)
            local dir = pred - ray.Origin
            if CurrentTool == "Double Barrel" or CurrentTool == "Tactical Shotgun" then
                dir = dir + Vector3.new(math.random(-80,80)/100, math.random(-80,80)/100, math.random(-80,80)/100)
            end
            args[1] = Ray.new(ray.Origin, dir.Unit * 1000)
            return oldnc(self, table.unpack(args))
        end
    end
    return oldnc(self, ...)
end))

local oldidx
oldidx = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if checkcaller() then return oldidx(self, key) end
    local activeHRP = Target.HRP or CamlockTarget
    if S.Enabled and S.Silent and self == Mouse and activeHRP and Target.Player then
        if key == "Hit" then
            local part = GetTargetPart(Target.Player) or activeHRP
            return CFrame.new(part.Position + part.Velocity * S.Prediction + Vector3.new(0, S.JumpOffset, 0))
        elseif key == "Target" then
            return activeHRP
        end
    end
    return oldidx(self, key)
end))

