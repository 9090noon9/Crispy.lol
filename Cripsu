local DEFAULT_CAMERA_TYPE = Camera.CameraType

local function applyLock()
    if Target.Player then return end

    local closest, best = nil, math.huge
    local center = Camera.ViewportSize / 2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > 0 then
                local sp, on = Camera:WorldToViewportPoint(hrp.Position)
                if on then
                    local m = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if m < best then
                        best = m
                        closest = plr
                    end
                end
            end
        end
    end

    if not closest then return end

    Target.Player = closest
    Target.HRP = closest.Character.HumanoidRootPart
    CurrentTarget.Player = closest
    CurrentTarget.HRP = Target.HRP
    CamlockTarget = Target.HRP
    S.Camlock = true
    Camera.CameraType = Enum.CameraType.Scriptable

    Library:Notify("Locked " .. closest.Name)
end

local function releaseLock()
    Target.Player = nil
    Target.HRP = nil
    CurrentTarget.Player = nil
    CurrentTarget.HRP = nil
    CamlockTarget = nil
    S.Camlock = false
    Camera.CameraType = DEFAULT_CAMERA_TYPE

    Library:Notify("Unlocked")
end

local function toggleLock()
    if not S.Enabled then return end
    if Target.Player then
        releaseLock()
    else
        applyLock()
    end
end

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.H then
        toggleLock()
    end
end)

