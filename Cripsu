        local sp, on = cam:WorldToViewportPoint(pos)
        if not sp then return nil, false, 0 end
        return Vector2.new(sp.X, sp.Y), on, sp.Z
    end

    self.funcs.calc_box = function(pos)
        local cam = self.vars.camera
        if not cam then return nil, nil, false, false end

        local dist = (cam.CFrame.Position - pos).Magnitude
        if dist < 0.1 or dist > 6e9 then return nil, nil, false, false end

        local up = CFrame.new(pos)
        local v_top = pos + (up.UpVector * 1.8) + cam.CFrame.UpVector
        local v_bot = pos - (up.UpVector * 2.5) - cam.CFrame.UpVector

        local top, tr, tz = self.funcs.to_screen(v_top)
        local bot, br, bz = self.funcs.to_screen(v_bot)

        if not top or not bot or tz <= 0 or bz <= 0 then
            return nil, nil, false, false
        end

        local w = math.max(math.floor(math.abs(top.X - bot.X)), 3)
        local h = math.max(math.floor(math.max(math.abs(bot.Y - top.Y), w / 2)), 3)
        local size = Vector2.new(math.floor(math.max(h / 1.5, w)), h)
        local bpos = Vector2.new(
            math.floor(top.X * 0.5 + bot.X * 0.5 - size.X * 0.5),
            math.floor(math.min(top.Y, bot.Y))
        )

        return size, bpos, br, tr
    end

