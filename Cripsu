        if frame then
            if ESP.box.filled then
                frame.Visible = true
                frame.Position = UDim2.new(0, pos.X, 0, pos.Y - self.gui_inset.Y)
                frame.Size = UDim2.new(0, size.X, 0, size.Y)
                frame.BackgroundTransparency = ESP.box.transparency
            else
                frame.Visible = false
            end
        end
    end

    self.funcs.update_labels = function(player, pos, size, cache, char, cam, root)
