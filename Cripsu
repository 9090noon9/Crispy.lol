RunService:BindToRenderStep("CrispyCamlock", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if S.Camlock and CamlockTarget then
        if Camera.CameraType ~= Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Scriptable
        end

        local pred = CamlockTarget.Position
            + CamlockTarget.Velocity * S.CamPred
            + Vector3.new(0, S.CamJump, 0)

        local alpha = 1 - math.exp(-dt / math.max(S.CamSmooth, 0.001))
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pred), alpha)

    elseif Camera.CameraType == Enum.CameraType.Scriptable and not S.Camlock then
        Camera.CameraType = DEFAULT_CAMERA_TYPE
    end
end)

local oldnc
oldnc = hookmetamethod(game, "__namecall", newcclosure(function(self_, ...)
    if checkcaller() then
        return oldnc(self_, ...)
    end

    local method = getnamecallmethod()
    local args = { ... }
    local activeHRP = Target.HRP or CamlockTarget

    if S.Enabled and activeHRP and Target.Player then
        local hitPart = GetTargetPart(Target.Player)

        if method == "Raycast" and self_ == Workspace and #args >= 3 and hitPart then
            local pred = hitPart.Position
                + hitPart.Velocity * GetDynamicPrediction(hitPart)
                + Vector3.new(0, S.JumpOffset, 0)
            local dir = pred - args[1]
            args[2] = dir.Unit * 1000
            return oldnc(self_, table.unpack(args))
        end

        if string.find(method, "FindPartOnRay", 1, true) and typeof(args[1]) == "Ray" and hitPart then
            local pred = hitPart.Position
                + hitPart.Velocity * GetDynamicPrediction(hitPart)
                + Vector3.new(0, S.JumpOffset, 0)
            local dir = pred - args[1].Origin
            args[1] = Ray.new(args[1].Origin, dir.Unit * 1000)
            return oldnc(self_, table.unpack(args))
        end
    end

    return oldnc(self_, ...)
end))

